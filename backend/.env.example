# TradeGuard Backend Environment Variables
APP_NAME="TradeGuard API"
APP_ENV=development
DEBUG=True

# Allowed Frontend Origins (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# True Markets Integration
# "demo" for internal deterministic simulator (no secrets required)
# "uat" for True Markets Gateway sandbox
TM_ENV=demo
TM_API_BASE_URL=https://api.uat.truemarkets.co/v1/gateway
TM_ORGANIZATION_USER_ID=
TM_API_KEY=
TM_SIGNER_KEY_PATH=

# Deterministic Risk Limits
MAX_NOTIONAL_USD=25000.0
CONCENTRATION_THRESHOLD_PCT=0.40
QUOTE_TTL_SECONDS=30
